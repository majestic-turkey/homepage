# Caddy fetches and renews certificates automatically; point the A/AAAA records
# for both names at the VPS and this is the whole config.

thesaltworks.io {
	redir https://www.thesaltworks.io{uri} permanent
}

www.thesaltworks.io {
	encode zstd gzip

	# The homepage container publishes on loopback only, so this is reachable
	# from the host but not from outside the VPS.
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
